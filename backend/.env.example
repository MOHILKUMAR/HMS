# Swastik Hospital Management System - Backend Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Render / Railway / Supabase / Local Docker)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/swastik_hms?schema=public

# Security Secrets (Generate a strong 32+ char key)
JWT_SECRET=swastik_hospital_super_secret_jwt_key_2026_production
SESSION_SECRET=swastik_hospital_session_cookie_secret_2026

# Payment Gateway (Razorpay Sandbox/Test Key)
RAZORPAY_KEY_ID=rzp_test_sample12345
RAZORPAY_KEY_SECRET=sample_secret_key_12345

# SMS / WhatsApp Notification Gateway
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=AC_sample_sid_12345
TWILIO_AUTH_TOKEN=sample_auth_token_12345
TWILIO_PHONE_NUMBER=+1234567890
